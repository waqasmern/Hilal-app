{
  "name": "hilal-wholesaler-shop",
  "version": "1.0.0",
  "description": "Hilal Wholesaler Shop - Inventory, POS, Ledger, Accounting & Offline/Online Sync",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev --prefix frontend\" \"electron .\"",
    "backend": "node backend/server.js",
    "build:frontend": "npm run build --prefix frontend",
    "package": "npm run build:frontend && electron-builder build --win",
    "dist": "npm run build:frontend && electron-packager . \"Hilal Wholesaler Shop\" --platform=win32 --arch=x64 --out=dist --overwrite --asar --ignore=\"frontend/(src|app|components|node_modules|\\.next)\"",
    "dist:mac": "npm run build:frontend && electron-packager . \"Hilal Wholesaler Shop\" --platform=darwin --arch=x64 --out=dist_mac --overwrite --asar --ignore=\"frontend/(src|app|components|node_modules)\"",
    "dist:all": "npm run build:frontend && electron-packager . \"Hilal Wholesaler Shop\" --platform=win32,darwin --arch=x64 --out=dist_all --overwrite --asar --ignore=\"frontend/(src|app|components|node_modules)\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "wholesale",
    "inventory",
    "pos",
    "ledger",
    "electron",
    "nextjs",
    "sqlite",
    "postgres"
  ],
  "author": "Hilal Wholesaler",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "autoprefixer": "^10.6.1",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "electron-pos-printer": "^1.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "postcss": "^8.5.29",
    "qrcode": "^1.5.4",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.hilal.wholesaler",
    "productName": "Hilal Wholesaler Shop",
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "directories": {
      "output": "dist_pro"
    },
    "files": [
      "main.js",
      "package.json",
      "backend/**/*",
      "node_modules/**/*",
      "frontend/out/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
